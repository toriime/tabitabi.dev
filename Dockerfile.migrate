FROM node:24-alpine AS base
ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"
RUN corepack enable

FROM base AS deps
WORKDIR /app
RUN apk add --no-cache libc6-compat

RUN pnpm init
RUN node -e "const pkg = JSON.parse(require('fs').readFileSync('package.json', 'utf8')); pkg.scripts = pkg.scripts || {}; pkg.scripts.payload = 'cross-env PAYLOAD_CONFIG_PATH=src/payload.config.ts payload'; require('fs').writeFileSync('package.json', JSON.stringify(pkg, null, 2));"
RUN pnpm add payload tailwind-merge clsx sharp cross-env

FROM base AS migration
WORKDIR /app

# Copy node_modules from deps stage
COPY --from=deps /app/node_modules ./node_modules

# Copy only necessary files for migrations
COPY package.json ./
COPY tsconfig.json ./
COPY next.config.js ./
COPY src/payload.config.ts ./src/
COPY src/migrations ./src/migrations
COPY src/collections ./src/collections
COPY src/lib ./src/lib

# Set required environment variables for Payload config
ENV PAYLOAD_SECRET="migration-temporary-secret"
ENV PAYLOAD_S3_BUCKET="placeholder"
ENV PAYLOAD_S3_ACCESS_KEY_ID="placeholder"
ENV PAYLOAD_S3_SECRET_ACCESS_KEY="placeholder"
ENV PAYLOAD_S3_REGION="placeholder"
ENV PAYLOAD_S3_ENDPOINT="placeholder"
ARG DATABASE_URL
ENV PAYLOAD_DATABASE_URL=$DATABASE_URL


# Run migrations
ENTRYPOINT ["pnpm", "run", "payload", "migrate"]